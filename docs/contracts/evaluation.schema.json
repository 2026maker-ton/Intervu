{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intervu.local/contracts/evaluation-v1.schema.json",
  "title": "Intervu evidence-based evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "rubric_version", "model_version", "dimensions", "next_actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "rubric_version": {"const": "behavioral-ko-v1"},
    "model_version": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "level", "observation", "evidence", "abstention_reason"],
        "properties": {
          "id": {"enum": ["relevance", "evidence_specificity", "reasoning", "reflection"]},
          "status": {"enum": ["scored", "insufficient_evidence"]},
          "level": {"type": ["number", "null"], "minimum": 1, "maximum": 4, "multipleOf": 0.5},
          "observation": {"type": "string", "maxLength": 500},
          "abstention_reason": {"type": ["string", "null"], "maxLength": 300},
          "evidence": {
            "type": "array", "maxItems": 10,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["turn_id", "revision", "start_cp", "end_cp", "quote", "anchor_id", "answer_level"],
              "properties": {
                "turn_id": {"type": "string", "minLength": 1},
                "revision": {"type": "integer", "minimum": 1},
                "start_cp": {"type": "integer", "minimum": 0},
                "end_cp": {"type": "integer", "minimum": 1},
                "quote": {"type": "string", "minLength": 1, "maxLength": 1000},
                "anchor_id": {"type": "string", "pattern": "^(relevance|evidence_specificity|reasoning|reflection):[1-4]$"},
                "answer_level": {"type": "integer", "minimum": 1, "maximum": 4}
              }
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "scored"}}}, "then": {"properties": {"level": {"type": "number"}, "abstention_reason": {"type": "null"}, "evidence": {"minItems": 2}}}},
          {"if": {"properties": {"status": {"const": "insufficient_evidence"}}}, "then": {"properties": {"level": {"type": "null"}, "abstention_reason": {"type": "string", "minLength": 1}}}}
        ]
      }
    },
    "next_actions": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension_id", "action", "practice_question"],
        "properties": {
          "dimension_id": {"enum": ["relevance", "evidence_specificity", "reasoning", "reflection"]},
          "action": {"type": "string", "minLength": 1, "maxLength": 300},
          "practice_question": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    }
  }
}
