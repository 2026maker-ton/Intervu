# Intervu 환경 변수 예시. 실제 키는 절대 커밋하지 마세요.
# 복사해서 사용: copy .env.example .env  (Windows) / cp .env.example .env

# 데모 접속 토큰 (실제 로그인 도입 전 임시). 내장 기본값이 없으므로 반드시 설정한다.
# 외부에 공개하는 서버에서는 예시 값 대신 무작위 긴 문자열을 쓴다(브라우저 첫 접속 시 입력).
DEV_TOKEN_A=dev-user-a-token
DEV_TOKEN_B=dev-user-b-token

# --- Gemini (서버 전용. 브라우저에 노출 금지) ---
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 텍스트/전사 모델
# 주의(2026-10-24 실키 검증): gemini-2.5-flash-lite는 신규 사용자에게 404.
# gemini-3.5-flash-lite = 무료 tier 제공 + 유료 $0.30/$2.50 (현재 최저가 조합)
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# 429/5xx/타임아웃 시 1회 재시도 후 사용할 대체 모델(사전 검증된 것만)
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TIMEOUT_MS=12000
# 중요: 실제 사용자 데이터를 Gemini에 전송하려면 아래 두 조건을 모두 만족해야 합니다.
# 1) Cloud Billing 연결된 유료(Paid) 프로젝트의 키일 것 (무료 할당량은 학습·인간검토 대상)
# 2) 운영자가 DPA/보존/처리국가를 확인하고 true 로 설정할 것
GEMINI_PAID_ACK=false
# 무료 할당량 키로 '합성 전용 인스턴스'를 허용할지 (기본 false = 차단).
# true여도 일반 서버 실행에서는 Mock으로 동작한다. 합성 모드는 createApp({syntheticTraffic:true})
# 코드 호출(tools/gemini-e2e.mjs)로만 켜지며 요청 본문·환경변수로는 켤 수 없다.
GEMINI_ALLOW_UNPAID=false
# 무료 전용: true면 유료 과금 모델로 절대 전환하지 않는다 (기본 true).
# 이 값은 Google의 실제 결제 상태를 바꾸지 않으므로,
# AI Studio(https://aistudio.google.com)에서 결제 비활성 상태를 별도로 확인하세요.
GEMINI_FREE_ONLY=true

# --- Groq Whisper STT (서버 전용. 브라우저에 노출 금지) ---
# 발급: https://console.groq.com
# endpoint: https://api.groq.com/openai/v1/audio/transcriptions
GROQ_WHISPER_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_MS=30000
# 무료 tier 상한: 25MB, 녹음 120초 (초과 시 텍스트 입력으로 안내)
GROQ_MAX_AUDIO_BYTES=26214400
GROQ_MAX_RECORDING_SECONDS=120

# 세션 비용 상한 (USD). 사양 §13: 절약형 0.08
SESSION_HARD_CAP_USD=0.08
EVAL_RESERVE_USD=0.02
FINISH_RESERVE_USD=0.005
MONTHLY_API_BUDGET_USD=30

# 프로필 추출 남용 방지 (사양 §15: 계정당 분당2회/일10회, 1회 예약 $0.01)
PROFILE_RATE_PER_MINUTE=2
PROFILE_RATE_PER_DAY=10
PROFILE_EXTRACT_RESERVE_USD=0.01

# 킬 스위치: gemini 포함 시 외부 호출 강제 차단(Mock으로 동작)
# 예: KILL_PROVIDERS=gemini
KILL_PROVIDERS=none

# 서버
PORT=3000
DATA_TTL_DAYS_DEFAULT=30

# Admin: 월간 역량 관리·/metrics·/diagnostics 는 x-admin-token 헤더가 이 값과 일치할 때만 허용.
# 비워 두면 관리 기능이 꺼진다(열려 있지 않음). 쿼리스트링·본문으로는 받지 않는다.
ADMIN_TOKEN=
# Trend store file; empty string disables persistence
TRENDS_FILE=data/trends.json

# --- WP-B1 공급자 게이트(모두 기본 false/비움; 외부 호출은 키+BASE_URL+MODEL+LIVE_ACK+데이터 등급이 모두 충족될 때만) ---
# GEMINI_LIVE_ACK=false        # 운영자가 약관·데이터 처리를 확인했다고 선언(합성 데이터만 허용)
# GEMINI_REAL_DATA_ACK=false   # 실데이터 허용 선언(동의·만 19세 확인도 필요 — 동의 API 전에는 차단됨)
# GEMINI_BASE_URL=             # 기본 https://generativelanguage.googleapis.com/v1beta
# GROQ_LIVE_ACK=false          # Groq STT 사용 선언(이 값 없이는 음성 전사가 차단됨)
# GROQ_REAL_DATA_ACK=false
# ROUTE_DIALOGUE_NEXT=gemini   # operation별 공급자: mock|gemini|groq (ROUTE_CLAIMS_EXTRACT, ROUTE_EVALUATION_GENERATE, ROUTE_SPEECH_TRANSCRIBE, ROUTE_SPEECH_SYNTHESIZE)
# DOCS_RATE_PER_MINUTE=20 DOCS_RATE_PER_DAY=300 STT_RATE_PER_MINUTE=20 STT_RATE_PER_DAY=300 TURN_RATE_PER_MINUTE=60 TURN_RATE_PER_DAY=2000

# --- Claude 지원서 주장 추출 (WP-B3, 서버 전용). 코드에 기본 모델·URL 없음: 직접 확인해 채운다 ---
# LLM_ANALYSIS_PROVIDER=claude 일 때만 claims.extract가 Claude로 간다(기본 gemini). 합성 데이터만 전송 가능(실데이터는 REAL_DATA_ACK+동의+만 19세).
LLM_ANALYSIS_PROVIDER=
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=
CLAUDE_TIMEOUT_MS=20000
CLAUDE_LIVE_ACK=false
CLAUDE_REAL_DATA_ACK=false
# 공급자별 월 상한(USD): 현재 미강제(전역 MONTHLY_API_BUDGET_USD만 적용)
CLAUDE_MONTHLY_CAP_USD=
# 선택: 헤더 버전 값, 단가(USD/1M 토큰, 미설정=0 정산)
CLAUDE_API_VERSION=
CLAUDE_PRICE_IN_PER_M_USD=
CLAUDE_PRICE_OUT_PER_M_USD=
# --- WP-B2 DeepSeek 꼬리질문(dialogue.next). 이름만; 값은 개발자가 공식 문서 확인 후 설정. 모델·URL 기본값 없음(미설정이면 Mock). ---
# LLM_DIALOGUE_PROVIDER=deepseek   # 기본 gemini. deepseek로 하면 꼬리질문만 DeepSeek 경유(게이트 통과 시)
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
# DEEPSEEK_LIVE_ACK=false          # 합성 데이터만 허용
# DEEPSEEK_REAL_DATA_ACK=false     # 실데이터 허용(동의·만 19세도 필요)
# DEEPSEEK_MONTHLY_CAP_USD=        # 비우면 달러 상한 없음(단가 PRICE_IN/OUT 필요)
# DEEPSEEK_MONTHLY_CALL_CAP=500    # 월 호출 수 상한(인메모리, 재시작 시 0)
# DEEPSEEK_PRICE_IN= DEEPSEEK_PRICE_OUT=   # USD/1M 토큰, 비우면 0
# DEEPSEEK_TIMEOUT_MS=12000

# --- WP-B6 ElevenLabs TTS(speech.synthesize). 이름만; 값은 개발자가 공식 문서 확인 후 설정. 모델·URL·음성 ID 기본값 없음. ---
# TTS_PROVIDER=elevenlabs          # 기본 mock(브라우저 TTS). 키·URL·모델·음성 ID·LIVE_ACK가 모두 있어야 서버 합성
# ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=
# ELEVENLABS_MODEL=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_LIVE_ACK=false        # 합성 데이터만 허용
# ELEVENLABS_REAL_DATA_ACK=false   # 실데이터 허용(동의·만 19세도 필요)
# ELEVENLABS_MONTHLY_CAP_USD=      # 비우면 달러 상한 없음(ELEVENLABS_PRICE_PER_1K_CHARS 필요)
# ELEVENLABS_MONTHLY_CALL_CAP=500  # 월 호출 수 상한(인메모리, 재시작 시 0)
# ELEVENLABS_CHAR_CAP=600          # 요청 1건당 합성 글자 상한(초과 시 브라우저 TTS)
# ELEVENLABS_MAX_AUDIO_BYTES=2097152
# ELEVENLABS_TIMEOUT_MS=15000
# TTS_RATE_PER_MINUTE=10  TTS_RATE_PER_DAY=200
# --- 공식 자료 수집(WP-C2) ---
# 허용 도메인 접미사(쉼표). 비어 있으면(기본) 서버는 외부 사이트에 접속하지 않는다. 예: example.ac.kr,example.go.kr
OFFICIAL_FETCH_ALLOW=
OFFICIAL_FETCH_TIMEOUT_MS=8000
OFFICIAL_FETCH_MAX_BYTES=1048576
OFFICIAL_FETCH_RATE_PER_MINUTE=5
OFFICIAL_FETCH_RATE_PER_DAY=30

# --- 데모용 무료 구성(기능 확인 전용): Gemini 하나로 꼬리질문 + 지원서 주장 추출을 대체 ---
# GEMINI_API_KEY=...  GEMINI_LIVE_ACK=true   # 합성 샘플(서버 fixture 일치 데이터)에서만 외부 전송, 그 외는 Mock
# LLM_DIALOGUE_PROVIDER=gemini  LLM_ANALYSIS_PROVIDER=gemini   # 기본값과 같음. 나중에 deepseek / claude로 바꿀 때는 이 두 줄과 해당 공급자 변수만 교체
# STT는 Groq(GROQ_*) 또는 브라우저 음성 인식, TTS는 브라우저 SpeechSynthesis

# --- 학생 MVP(2026-10-30, docs/plan/09). 주석 처리된 이름만; 기본값은 괄호 ---
# Gemini가 단일 활성 LLM. Claude·DeepSeek·ElevenLabs 설정은 보류(위 항목은 유지되지만 기본 꺼짐).
# 고입(미성년자) 실입력은 아래 어떤 값이 있어도 외부 AI로 가지 않는다(서버 fixture 합성 판정 요청만 예외).
# LLM_EVALUATION_PROVIDER=gemini   # (기본 gemini) 평가 공급자. 실패·게이트 닫힘이면 규칙 기반 폴백. UI 칩 "Gemini 분석 · 검증 전(참고용)"
# ROUTE_SCHOOL_ANALYZE=gemini      # (기본 LLM_ANALYSIS_PROVIDER 또는 gemini) 학교 분석. mock이면 규칙 기반
# ROUTE_TRENDS_DECIDE=gemini       # (기본 gemini) 트렌드 조회 필요 판단. 막히면 트렌드 미사용
# ROUTE_QUESTIONS_DESIGN=gemini    # (기본 gemini) 승인 시 질문 설계. mock이면 규칙 기반 계획
# ROUTE_EVALUATION_GENERATE=gemini # (기본 LLM_EVALUATION_PROVIDER 또는 gemini)
# ROUTE_SPEECH_TRANSCRIBE=groq     # (기본 groq) 음성 전사
# TREND_MOCK_MONTH=2026-10         # (비우면 현재 월) Mock 월간 트렌드 조회 월. Mock 데이터는 2026-09~12만 있고 그 외 월은 unavailable
# GEMINI_LIVE_ACK=true             # 합성 샘플(서버 fixture 일치)에서만 외부 전송. 실데이터는 GEMINI_REAL_DATA_ACK+동의+만 19세 확인 필요
# GROQ_LIVE_ACK=true               # 음성 전사 허용 선언. 실음성은 GROQ_REAL_DATA_ACK+성인 동의 필요(미성년·무동의면 서버 전사 차단)
